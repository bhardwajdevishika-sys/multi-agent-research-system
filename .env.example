# ─── AI Multi-Research Agent — Environment Variables ─────────────────────────
# Copy this file to .env and fill in your real values.
# Never commit the actual .env file — it is in .gitignore.

# ─── Flask ────────────────────────────────────────────────────────────────────
# A random, hard-to-guess string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_flask_secret_key_here

# ─── HuggingFace Inference API ────────────────────────────────────────────────
# Required for all LLM calls (Mixtral, Llama-3, Gemma-2).
# Create a free token at: https://huggingface.co/settings/tokens
# Ensure the token has "Read" scope and is accepted on any gated models you use.
HUGGINGFACE_TOKEN=hf_your_token_here

# ─── Web Search ───────────────────────────────────────────────────────────────
# Optional but recommended — enables advanced Tavily search with full page content.
# Sign up for a free key at: https://app.tavily.com
# If not set, the system falls back to DuckDuckGo automatically.
TAVILY_API_KEY=tvly-your_key_here

# ─── LLM Model Chain (optional overrides) ────────────────────────────────────
# Default values are used when these are not set.
# Must be valid HuggingFace model IDs accessible via the Inference API.
LLM_MODEL_ID=mistralai/Mixtral-8x7B-Instruct-v0.1
LLM_MODEL_FALLBACK_1=meta-llama/Meta-Llama-3-8B-Instruct
LLM_MODEL_FALLBACK_2=google/gemma-2-9b-it

# ─── Embedding Model ─────────────────────────────────────────────────────────
# Small local sentence-transformers model (~90 MB). Change only if needed.
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cpu

# ─── RAG / Chunking ───────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ─── Search Behaviour ─────────────────────────────────────────────────────────
# Maximum number of web results fetched per research query.
MAX_SEARCH_RESULTS=5

# ─── Paths (usually no need to change) ───────────────────────────────────────
VECTOR_DB_PATH=backend/memory/research_memory/faiss_index
